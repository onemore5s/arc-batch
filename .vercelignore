# 默认不上传文件，只允许构建所需的输入。
/*
!/.vercelignore
!/vercel.json
!/package.json
!/package-lock.json
!/index.html
!/tsconfig.json
!/vite.config.ts

!/src
/src/**
!/src/chain
!/src/domain
!/src/generated
!/src/i18n
!/src/**/*.ts
!/src/**/*.tsx
!/src/**/*.css

!/contracts
/contracts/**
!/contracts/src
!/contracts/src/*.sol

!/scripts
/scripts/**
!/scripts/build-contract.mjs
!/scripts/public-assets.ts

!/public
/public/**
!/public/arc-batch.svg
!/public/deployments
!/public/deployments/mainnet.json
!/public/deployments/testnet.json
!/public/deployments/testnet-legacy-2.json

# 即使放入允许上传的目录，也不上传环境文件、密钥或 source map。
**/.env*
**/*.pem
**/*.key
**/id_rsa*
**/id_ed25519*
**/*keystore*
**/*.map
