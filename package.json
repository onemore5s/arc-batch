{
  "name": "arc-batch",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run abi && tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "contracts:test": "npm run abi && node scripts/foundry.mjs forge test --root contracts",
    "contracts:arc": "npm run abi && node scripts/foundry.mjs forge test --root contracts --network arc",
    "contracts:coverage": "npm run abi && node scripts/foundry.mjs forge coverage --root contracts --report lcov --no-match-coverage \"(lib|test)/\"",
    "abi": "node scripts/build-contract.mjs",
    "e2e": "playwright test",
    "e2e:appkit": "playwright test --config playwright.appkit.config.ts",
    "check": "npm run abi && npm run typecheck && npm run lint && npm run format && npm run coverage && npm run scripts:test && npm run contracts:test && npm run build",
    "scripts:test": "node --test scripts/*.test.mjs",
    "deploy": "node scripts/deploy.mjs",
    "verify:deployment": "node scripts/verify-deployment.mjs",
    "measure": "node scripts/measure.mjs",
    "lint": "eslint src tests e2e scripts *.config.*",
    "format": "prettier --check src tests e2e scripts docs .github README.md CONTRIBUTING.md SECURITY.md *.json *.config.*"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.6.1",
    "@reown/appkit": "1.8.24",
    "@reown/appkit-adapter-wagmi": "1.8.24",
    "@tanstack/react-query": "5.104.2",
    "@wagmi/core": "2.22.1",
    "idb": "8.0.4",
    "lucide-react": "1.52.0",
    "papaparse": "5.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "viem": "2.57.3",
    "wagmi": "2.19.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@foundry-rs/anvil": "1.7.1",
    "@foundry-rs/cast": "1.7.1",
    "@foundry-rs/forge": "1.7.1",
    "@playwright/test": "1.64.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/papaparse": "5.5.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.5",
    "jsdom": "30.1.2",
    "prettier": "3.9.9",
    "solc": "0.8.30",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  },
  "overrides": {
    "tmp": "0.2.7",
    "@wagmi/connectors": "6.2.0",
    "ws@^8.0.0": "8.22.0"
  },
  "description": "Batch USDC payments on Arc.",
  "license": "MIT"
}
