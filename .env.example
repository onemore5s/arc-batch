# Public frontend configuration: a verified file from public/deployments.
VITE_DEPLOYMENT_FILE=<deployment-manifest-filename>
# Public Reown Dashboard project ID; enables AppKit and WalletConnect.
VITE_REOWN_PROJECT_ID=<Reown-project-ID>
# Deployment scripts only. Never put a private key in frontend variables.
ARC_NETWORK=<mainnet-or-testnet>
ARC_MAX_RECIPIENTS=<positive-integer-validated-by-gas-measurement>
ARC_KEYSTORE_ACCOUNT=<encrypted-cast-keystore-account-name>
